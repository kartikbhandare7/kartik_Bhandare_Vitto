```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.pid.lock

# Coverage
coverage/

# Build output
dist/
build/

# Cache
.cache/
.parcel-cache/
.eslintcache

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Optional npm cache
.npm/

# Vite
vite.svg
```
